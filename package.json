{
  "name": "breakerbot",
  "version": "2.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:api": "node dist/api/server.js",
    "dev": "concurrently --names \"BOT,API\" --prefix-colors \"green,blue\" \"npm run dev:bot\" \"npm run dev:api\"",
    "dev:bot": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "menu": "tsx scripts/print-menu.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm run build && pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop BreakerBot BreakerBotAPI",
    "restart": "npm run build && pm2 restart BreakerBot BreakerBotAPI --update-env",
    "logs": "pm2 logs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.8.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "link-preview-js": "^4.0.4",
    "openai": "^4.89.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.32.6",
    "socket.io": "^4.8.3",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/qrcode-terminal": "^0.12.2",
    "concurrently": "^9.1.2",
    "pm2": "^7.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "overrides": {
    "link-preview-js": "^4.0.4"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "ffmpeg-static@5.3.0": true,
    "yt-dlp-exec@1.0.2": true,
    "protobufjs@7.6.5": true,
    "@whiskeysockets/baileys@7.0.0-rc13": true
  }
}
